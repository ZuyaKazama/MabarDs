@@ -52,6 +52,30 @@ GLRenderer::GLRenderer(melonDS::NDS& nds, bool compute)
     ScaleFactor = 0;
 }
 
+
+#ifdef MELONDS_GLES
+// EmuNDS: textures (re)allocated by a resolution change hold undefined memory on Mali/Adreno
+// (visible as garbage until every pass has rendered again), so clear them.
+static inline void EmundsClearFB(GLuint fb, int numColor, bool depthStencil, float alpha)
+{
+    glBindFramebuffer(GL_FRAMEBUFFER, fb);
+    glDisable(GL_SCISSOR_TEST);
+    for (int i = 0; i < numColor; i++)
+        glColorMaski(i, GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glClearColor(0, 0, 0, alpha);
+    GLbitfield bits = numColor ? GL_COLOR_BUFFER_BIT : 0;
+    if (depthStencil)
+    {
+        glDepthMask(GL_TRUE);
+        glStencilMask(0xFF);
+        glClearDepthf(1.f);
+        glClearStencil(0);
+        bits |= GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT;
+    }
+    glClear(bits);
+}
+#endif
+
 #define glTexParams(target, wrap) \
